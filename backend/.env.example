# Роль окружения: dev (дефолт) | prod.
# dev  — guard разрешает мутировать только loopback и DB_EXTRA_TARGETS
# prod — цели не проверяются; на развёрнутом окружении ВЫСТАВИТЬ ЯВНО
APP_ENV=dev
# Дополнительные не-loopback цели, мутируемые в dev: host:port/dbname через запятую
# DB_EXTRA_TARGETS=

# Postgres 16 + pgvector (локальный кластер на 5459)
DATABASE_URL=postgresql+psycopg://postgres@localhost:5459/gca_dev

# JWT — сгенерировать: openssl rand -hex 32
SECRET_KEY=<openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Куки (False на dev без HTTPS, True в проде)
COOKIE_SECURE=False

# CORS — конкретный origin фронтенда (не *)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Файловое хранилище (AGENTS.md §8) — директория для XLSX-файлов import_jobs
# STORAGE_DIR=../storage
# Лимит загрузки, МБ
# UPLOAD_MAX_SIZE_MB=25
# Мягкий таймаут импорта, минут
# IMPORT_SOFT_TIMEOUT_MINUTES=10
# Ретенция файлов error-jobs, дней
# ERROR_JOB_FILE_RETENTION_DAYS=30
# Обслуживание при старте: recovery зависших import_jobs (§5) + ретенция (§8).
# В проде НЕ выключать: recovery — условие того, что прерванный импорт не оставит
# зависшего задания. False нужен только тестам.
# RUN_STARTUP_MAINTENANCE=True

# Логи (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Семантические предложения (спека 2026-09-28-semantic-suggestions-design.md)
# Ключ OpenRouter — секрет, не коммитить настоящее значение
OPENROUTER_API_KEY=
# Исполнитель захвата — включать явно, когда очередь готова к работе
# RUN_SEMANTIC_WORKER=False
# Допустимые значения (иначе приложение не стартует): SEMANTIC_MAX_TOKENS,
# SEMANTIC_CONCURRENCY, SEMANTIC_CALL_TIMEOUT_S, SEMANTIC_MAX_ATTEMPTS — целые >= 1;
# SEMANTIC_SHUTDOWN_WAIT_S, SEMANTIC_EVENT_MAX_CONTEXTS — целые >= 0;
# SEMANTIC_PRICE_*, SEMANTIC_DAILY_BUDGET_USD, SEMANTIC_EVENT_MAX_RESERVE_USD — >= 0
# SEMANTIC_MODEL=anthropic/claude-sonnet-5
# SEMANTIC_MAX_TOKENS=600
# SEMANTIC_CONCURRENCY=4
# SEMANTIC_CALL_TIMEOUT_S=120
# SEMANTIC_SHUTDOWN_WAIT_S=15
# SEMANTIC_MAX_ATTEMPTS=3
# Тарифы, $ за миллион токенов (Decimal, не константы кода)
# SEMANTIC_PRICE_INPUT_PER_M=2
# SEMANTIC_PRICE_CACHE_WRITE_PER_M=2.5
# SEMANTIC_PRICE_CACHE_READ_PER_M=0.2
# SEMANTIC_PRICE_OUTPUT_PER_M=10
# SEMANTIC_DAILY_BUDGET_USD=30
# SEMANTIC_EVENT_MAX_CONTEXTS=3000
# SEMANTIC_EVENT_MAX_RESERVE_USD=15
