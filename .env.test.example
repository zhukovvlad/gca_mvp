# Скопируй в .env.test и заполни. .env.test не коммитится (в .gitignore).
# Используется ТОЛЬКО для локальных тестов. В CI переменные приходят из GitHub Actions.

# Локальный тестовый кластер (PostgreSQL 16 + pgvector, порт 5459).
# Имя БД ОБЯЗАНО оканчиваться на _test — conftest перед прогоном делает DROP SCHEMA.
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5459/gca_test
